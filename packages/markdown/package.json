{
  "name": "@litter-bear/markdown",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "跨端共享的 Markdown 渲染管线（markdown-it + KaTeX → 内联样式 HTML 字符串）",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
