{
  "name": "@litter-bear/types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "前后端共享类型（公共类型 . / 流式通讯协议 ./protocol）",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js",
      "default": "./dist/protocol/index.js"
    },
    "./agent-flow": {
      "types": "./dist/agent-flow/index.d.ts",
      "import": "./dist/agent-flow/index.js",
      "default": "./dist/agent-flow/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
