generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                      @id @default(cuid())
  nickname          String                      @default("用户")
  avatarUrl         String                      @default("")
  role              UserRole                    @default(USER)
  username          String?                     @unique
  passwordHash      String?                     @map("password_hash")
  passwordUpdatedAt DateTime?                   @map("password_updated_at")
  phone             String?                     @unique
  wechatOpenId      String?                     @unique @map("wechat_open_id")
  wechatUnionId     String?                     @unique @map("wechat_union_id")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  conversations     Conversation[]
  sseTasks          SseTask[]
  streamTasks       StreamTask[]
  turnTraceItems    ConversationTurnTraceItem[]
  createdAgents     Agent[]

  @@map("users")
}

/// 数据化的智能体定义：把原本写死的 system prompt / 工具组 / 执行策略变成可管理的一等实体。
/// 空/AUTO 字段表示"不覆盖"（沿用消息驱动的默认行为），而非"空集"。
model Agent {
  id                String          @id @default(cuid())
  name              String
  description       String          @default("")
  systemPrompt      String?         @map("system_prompt") @db.Text
  modelPreset       String?         @map("model_preset")
  defaultStrategy   AgentStrategy   @default(AUTO) @map("default_strategy")
  allowedStrategies AgentStrategy[] @default([]) @map("allowed_strategies")
  toolGroups        String[]        @default([]) @map("tool_groups")
  skills            String[]        @default([])
  maxSteps          Int?            @map("max_steps")
  enabled           Boolean         @default(true)
  isDefault         Boolean         @default(false) @map("is_default")
  createdById       String?         @map("created_by_id")
  createdBy         User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([enabled])
  @@index([isDefault])
  @@map("agents")
}

model Conversation {
  id             String                      @id @default(cuid())
  title          String                      @default("新对话")
  userId         String                      @map("user_id")
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       Message[]
  summary        ConversationSummary?
  sseTasks       SseTask[]
  streamTasks    StreamTask[]
  turnTraceItems ConversationTurnTraceItem[]
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")

  @@index([userId])
  @@map("conversations")
}

model ConversationSummary {
  id              String       @id @default(cuid())
  conversationId  String       @unique @map("conversation_id")
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  summary         String       @db.Text
  latestMessageId String?      @map("latest_message_id")
  messageCount    Int          @default(0) @map("message_count")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("conversation_summaries")
}

model Message {
  id             String                      @id @default(cuid())
  role           MessageRole
  content        String                      @db.Text
  imageUrl       String?                     @map("image_url")
  status         MessageStatus               @default(DONE)
  conversationId String                      @map("conversation_id")
  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime                    @default(now()) @map("created_at")
  sseTasks       SseTask[]
  streamTasks    StreamTask[]
  turnTraceItems ConversationTurnTraceItem[]

  @@index([conversationId])
  @@map("messages")
}

model SseTask {
  id              String        @id @default(cuid())
  type            SseTaskType
  status          SseTaskStatus @default(PENDING)
  userId          String        @map("user_id")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId  String        @map("conversation_id")
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId       String        @map("message_id")
  message         Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  requestPayload  Json          @map("request_payload")
  lastEventId     Int           @default(0) @map("last_event_id")
  fullContent     String        @default("") @map("full_content") @db.Text
  errorMessage    String?       @map("error_message") @db.Text
  startedAt       DateTime?     @map("started_at")
  lastHeartbeatAt DateTime?     @map("last_heartbeat_at")
  completedAt     DateTime?     @map("completed_at")
  expiresAt       DateTime      @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([conversationId])
  @@index([messageId])
  @@map("sse_tasks")
}

model StreamTask {
  id              String                      @id @default(cuid())
  type            StreamTaskType
  status          StreamTaskStatus            @default(PENDING)
  userId          String                      @map("user_id")
  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId  String?                     @map("conversation_id")
  conversation    Conversation?               @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId       String?                     @map("message_id")
  message         Message?                    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  requestPayload  Json                        @map("request_payload")
  executionState  Json?                       @map("execution_state")
  resultPayload   Json?                       @map("result_payload")
  agentId         String?                     @map("agent_id")
  currentAgent    String?                     @map("current_agent")
  currentStep     String?                     @map("current_step")
  currentRunId    String?                     @map("current_run_id")
  lastEventId     Int                         @default(0) @map("last_event_id")
  fullContent     String                      @default("") @map("full_content") @db.Text
  errorMessage    String?                     @map("error_message") @db.Text
  startedAt       DateTime?                   @map("started_at")
  pausedAt        DateTime?                   @map("paused_at")
  lastHeartbeatAt DateTime?                   @map("last_heartbeat_at")
  completedAt     DateTime?                   @map("completed_at")
  expiresAt       DateTime?                   @map("expires_at")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")
  runs            StreamTaskRun[]             @relation("StreamTaskRuns")
  events          StreamTaskEvent[]
  turnTraceItems  ConversationTurnTraceItem[]

  @@index([userId, status])
  @@index([conversationId])
  @@index([messageId])
  @@index([currentRunId])
  @@index([agentId])
  @@map("stream_tasks")
}

model StreamTaskRun {
  id             String                      @id @default(cuid())
  taskId         String                      @map("task_id")
  task           StreamTask                  @relation("StreamTaskRuns", fields: [taskId], references: [id], onDelete: Cascade)
  sequence       Int
  status         StreamTaskRunStatus         @default(PENDING)
  trigger        String?
  startEventId   Int                         @default(0) @map("start_event_id")
  endEventId     Int?                        @map("end_event_id")
  closeReason    String?                     @map("close_reason")
  startedAt      DateTime?                   @map("started_at")
  endedAt        DateTime?                   @map("ended_at")
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")
  events         StreamTaskEvent[]
  turnTraceItems ConversationTurnTraceItem[]

  @@unique([taskId, sequence])
  @@index([taskId, status])
  @@map("stream_task_runs")
}

model StreamTaskEvent {
  id        String         @id @default(cuid())
  taskId    String         @map("task_id")
  streamId  String?        @map("stream_id")
  task      StreamTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stream    StreamTaskRun? @relation(fields: [streamId], references: [id], onDelete: SetNull)
  eventId   Int            @map("event_id")
  eventName String         @map("event_name")
  payload   Json
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([taskId, eventId])
  @@index([taskId, eventId])
  @@index([streamId])
  @@map("stream_task_events")
}

/// 单轮对话执行轨迹项，用于历史消息回显“这轮回复走过哪些决策、节点和工具调用”。
/// 它不是 token 级流式快照；message.delta/tool.call.delta 这类高频事件应只用于实时展示或短期恢复。
model ConversationTurnTraceItem {
  id             String                      @id @default(cuid())
  userId         String                      @map("user_id")
  conversationId String                      @map("conversation_id")
  messageId      String                      @map("message_id")
  taskId         String?                     @map("task_id")
  runId          String?                     @map("run_id")
  parentId       String?                     @map("parent_id")
  traceKey       String?                     @map("trace_key")
  sequence       Int
  depth          Int                         @default(0)
  type           ConversationTraceItemType
  status         ConversationTraceItemStatus @default(RUNNING)
  title          String
  summary        String?                     @db.Text
  detail         String?                     @db.Text
  strategy       String?
  skill          String?
  graph          String?
  nodeKey        String?                     @map("node_key")
  toolName       String?                     @map("tool_name")
  mcpServer      String?                     @map("mcp_server")
  mcpTool        String?                     @map("mcp_tool")
  inputSummary   Json?                       @map("input_summary")
  outputSummary  Json?                       @map("output_summary")
  error          Json?
  metrics        Json?
  metadata       Json?
  startedAt      DateTime?                   @map("started_at")
  endedAt        DateTime?                   @map("ended_at")
  durationMs     Int?                        @map("duration_ms")
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")

  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message                     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  task         StreamTask?                 @relation(fields: [taskId], references: [id], onDelete: SetNull)
  run          StreamTaskRun?              @relation(fields: [runId], references: [id], onDelete: SetNull)
  parent       ConversationTurnTraceItem?  @relation("TraceItemChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children     ConversationTurnTraceItem[] @relation("TraceItemChildren")

  @@index([taskId, traceKey])
  @@index([conversationId, messageId, sequence])
  @@index([taskId, sequence])
  @@index([runId])
  @@index([parentId])
  @@index([type])
  @@map("conversation_turn_trace_items")
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageStatus {
  STREAMING
  DONE
  ERROR
}

enum UserRole {
  USER
  ADMIN
}

enum AgentStrategy {
  AUTO
  DIRECT
  REACT
  PLAN_EXECUTE
  HYBRID
}

enum ConversationTraceItemType {
  STRATEGY_DECISION
  SKILL_SELECTION
  WORKFLOW_STEP
  REACT_NODE
  HYBRID_NODE
  PLAN_NODE
  MODEL_CALL
  TOOL_CALL
  MCP_CALL
  MEMORY_READ
  MEMORY_WRITE
  MESSAGE_FINALIZE
  ERROR
}

enum ConversationTraceItemStatus {
  RUNNING
  SUCCESS
  ERROR
  SKIPPED
  CANCELED
}

enum SseTaskType {
  CHAT_COMPLETION
  VOICE_COMPLETION
}

enum SseTaskStatus {
  PENDING
  STREAMING
  PAUSED
  COMPLETED
  ERROR
  EXPIRED
  CANCELED
}

enum StreamTaskType {
  CHAT_COMPLETION
  VOICE_COMPLETION
  AGENT_WORKFLOW
}

enum StreamTaskStatus {
  PENDING
  STREAMING
  PAUSED
  WAITING_HUMAN
  COMPLETED
  ERROR
  EXPIRED
  CANCELED
}

enum StreamTaskRunStatus {
  PENDING
  STREAMING
  CLOSED
  COMPLETED
  ERROR
  CANCELED
  TIMEOUT
}

model SmsCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, code])
  @@map("sms_codes")
}
