generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                      @id @default(cuid())
  nickname                  String                      @default("用户")
  avatarUrl                 String                      @default("")
  role                      UserRole                    @default(USER)
  username                  String?                     @unique
  passwordHash              String?                     @map("password_hash")
  passwordUpdatedAt         DateTime?                   @map("password_updated_at")
  phone                     String?                     @unique
  wechatOpenId              String?                     @unique @map("wechat_open_id")
  wechatUnionId             String?                     @unique @map("wechat_union_id")
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")
  conversations             Conversation[]
  sseTasks                  SseTask[]
  streamTasks               StreamTask[]
  turnTraceItems            ConversationTurnTraceItem[]
  createdAgents             Agent[]
  storageAssets             StorageAsset[]
  mcdonaldsOrders           McDonaldsOrder[]
  mcdonaldsCredentials      McDonaldsCredential[]
  mcpConnectionAudits       McpConnectionAudit[]
  createdAgentFlows         AgentFlow[]                 @relation("AgentFlowCreator")
  createdAgentFlowVersions  AgentFlowVersion[]          @relation("AgentFlowVersionCreator")
  decidedAgentFlowApprovals AgentFlowApproval[]         @relation("AgentFlowApprovalDecider")
  agentFlowAuditLogs        AgentFlowAuditLog[]         @relation("AgentFlowAuditActor")
  agentFlowSignalOutbox     AgentFlowSignalOutbox[]     @relation("AgentFlowSignalOutboxActor")

  @@map("users")
}

/// 用户自行在麦当劳 MCP 平台生成并绑定的凭据。明文 Token 只在服务端请求范围内解密使用。
model McDonaldsCredential {
  id               String                    @id @default(cuid())
  userId           String                    @map("user_id")
  tokenCiphertext  String                    @map("token_ciphertext") @db.Text
  tokenFingerprint String                    @map("token_fingerprint")
  status           McDonaldsCredentialStatus @default(ACTIVE)
  verifiedAt       DateTime?                 @map("verified_at")
  lastError        String?                   @map("last_error") @db.Text
  revokedAt        DateTime?                 @map("revoked_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders           McDonaldsOrder[]
  connectionAudits McpConnectionAudit[]

  @@index([userId, status])
  @@index([userId, tokenFingerprint])
  @@map("mcdonalds_credentials")
}

/// 会话外 MCP 连接操作的安全审计。用于用户授权、连接健康等没有 Conversation/StreamTask 上下文的调用。
model McpConnectionAudit {
  id           String                      @id @default(cuid())
  userId       String                      @map("user_id")
  credentialId String?                     @map("credential_id")
  mcpServer    String                      @map("mcp_server")
  operation    McpConnectionAuditOperation
  mcpTool      String?                     @map("mcp_tool")
  status       McpConnectionAuditStatus
  durationMs   Int?                        @map("duration_ms")
  errorMessage String?                     @map("error_message") @db.Text
  createdAt    DateTime                    @default(now()) @map("created_at")

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential McDonaldsCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([credentialId, createdAt])
  @@index([mcpServer, status, createdAt])
  @@map("mcp_connection_audits")
}

/// 对象存储资源登记：一处上传、多处复用；失效走软标记而非物理删行
/// （历史消息/Agent 可能仍引用，删行会失去溯源）。key 为唯一事实源，
/// 访问 URL 由域名 + key 运行时拼出，换 CDN 域名/存储商不用刷库。
model StorageAsset {
  id           String             @id @default(cuid())
  /// 对象 key：image/202608/{userId}/{uuid}.png
  key          String             @unique
  kind         StorageAssetKind
  /// 业务用途标签：agent-avatar / chat-image / voice-input ...
  usage        String             @default("")
  mimeType     String?            @map("mime_type")
  /// 字节数（客户端上报，用于展示与统计）
  size         Int?
  status       StorageAssetStatus @default(ACTIVE)
  uploadedById String?            @map("uploaded_by_id")
  uploadedBy   User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([usage, status, createdAt])
  @@index([uploadedById])
  @@map("storage_assets")
}

enum StorageAssetKind {
  IMAGE
  AUDIO
}

enum StorageAssetStatus {
  /// 可用
  ACTIVE
  /// 远端已失效（被清理/审核下架/404），系统标记
  BROKEN
  /// 用户主动删除（逻辑删）
  DELETED
}

/// 数据化的智能体定义：把原本写死的 system prompt / 工具组 / 执行策略变成可管理的一等实体。
/// 空/AUTO 字段表示"不覆盖"（沿用消息驱动的默认行为），而非"空集"。
model Agent {
  id                   String            @id @default(cuid())
  name                 String
  description          String            @default("")
  /// 头像 URL；null = 客户端显示名称首字
  avatar               String?
  systemPrompt         String?           @map("system_prompt") @db.Text
  modelPreset          String?           @map("model_preset")
  defaultStrategy      AgentStrategy     @default(AUTO) @map("default_strategy")
  allowedStrategies    AgentStrategy[]   @default([]) @map("allowed_strategies")
  toolGroups           String[]          @default([]) @map("tool_groups")
  skills               String[]          @default([])
  maxSteps             Int?              @map("max_steps")
  enabled              Boolean           @default(true)
  isDefault            Boolean           @default(false) @map("is_default")
  defaultFlowVersionId String?           @map("default_flow_version_id")
  defaultFlowVersion   AgentFlowVersion? @relation("AgentDefaultFlowVersion", fields: [defaultFlowVersionId], references: [id], onDelete: SetNull)
  createdById          String?           @map("created_by_id")
  createdBy            User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@index([enabled])
  @@index([isDefault])
  @@index([defaultFlowVersionId])
  @@map("agents")
}

/// 管理员维护的逻辑 Flow，当前发布版本由 publishedVersionId 唯一指向。
model AgentFlow {
  id                 String   @id @default(cuid())
  name               String
  description        String   @default("") @db.Text
  publishedVersionId String?  @unique @map("published_version_id")
  createdById        String?  @map("created_by_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  createdBy        User?               @relation("AgentFlowCreator", fields: [createdById], references: [id], onDelete: SetNull)
  versions         AgentFlowVersion[]  @relation("AgentFlowVersions")
  publishedVersion AgentFlowVersion?   @relation("AgentFlowPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  auditLogs        AgentFlowAuditLog[] @relation("AgentFlowAuditLogs")

  @@index([createdById])
  @@map("agent_flows")
}

/// 不可变的 FlowDefinition JSON 工件；只有 DRAFT 可以被编辑覆盖。
model AgentFlowVersion {
  id            String                 @id @default(cuid())
  flowId        String                 @map("flow_id")
  version       Int
  status        AgentFlowVersionStatus @default(DRAFT)
  definition    Json
  digest        String?
  schemaVersion Int                    @map("schema_version")
  createdById   String?                @map("created_by_id")
  publishedAt   DateTime?              @map("published_at")
  archivedAt    DateTime?              @map("archived_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  flow             AgentFlow           @relation("AgentFlowVersions", fields: [flowId], references: [id], onDelete: Restrict)
  createdBy        User?               @relation("AgentFlowVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  publishedForFlow AgentFlow?          @relation("AgentFlowPublishedVersion")
  defaultForAgents Agent[]             @relation("AgentDefaultFlowVersion")
  taskSnapshots    StreamTask[]        @relation("StreamTaskFlowVersion")
  auditLogs        AgentFlowAuditLog[] @relation("AgentFlowVersionAuditLogs")

  @@unique([flowId, version])
  @@index([flowId, status])
  @@index([createdById])
  @@map("agent_flow_versions")
}

/// Flow 控制面操作的最小审计记录，不复制 Definition 或其他敏感内容。
model AgentFlowAuditLog {
  id        String               @id @default(cuid())
  flowId    String               @map("flow_id")
  versionId String?              @map("version_id")
  action    AgentFlowAuditAction
  actorId   String?              @map("actor_id")
  digest    String?
  createdAt DateTime             @default(now()) @map("created_at")

  flow    AgentFlow         @relation("AgentFlowAuditLogs", fields: [flowId], references: [id], onDelete: Cascade)
  version AgentFlowVersion? @relation("AgentFlowVersionAuditLogs", fields: [versionId], references: [id], onDelete: SetNull)
  actor   User?             @relation("AgentFlowAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([flowId, createdAt])
  @@index([versionId, createdAt])
  @@index([actorId, createdAt])
  @@map("agent_flow_audit_logs")
}

/// 数据化的模型预设：后台是唯一配置入口，apiKey 以 AES-256-GCM 密文落库。
/// presetId 为业务标识（如 openai:gpt-5.5），供 Agent.modelPreset 引用与 registry 去重。
model ModelPreset {
  id              String              @id @default(cuid())
  presetId        String              @unique @map("preset_id")
  name            String
  description     String              @default("")
  platform        String
  model           String
  /// 上游 wire 格式；唯一决定用哪个 LangChain 客户端，SDK 由它推导
  upstreamFormat  ModelUpstreamFormat @default(OPENAI_CHAT_COMPLETIONS) @map("upstream_format")
  baseURL         String?             @map("base_url")
  temperature     Float?
  maxOutputTokens Int?                @map("max_output_tokens")
  topP            Float?              @map("top_p")
  enabled         Boolean             @default(true)
  isDefault       Boolean             @default(false) @map("is_default")

  /// 版本化 AES-256-GCM 密文（v1.<iv>.<authTag>.<ciphertext>）；明文只在解析请求期存在
  apiKeyCiphertext  String? @map("api_key_ciphertext") @db.Text
  /// apiKey 的 SHA-256 指纹，仅用于变更判断与脱敏展示，不可逆
  apiKeyFingerprint String? @map("api_key_fingerprint")

  /// 由连通性探针实测写入的能力档位，决定该预设能否被带工具的节点使用
  capability     ModelPresetCapability @default(UNVERIFIED)
  lastCheckedAt  DateTime?             @map("last_checked_at")
  /// 探针失败原因的安全文本，不含 key、请求体或响应原文
  lastCheckError String?               @map("last_check_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([enabled])
  @@index([isDefault])
  @@map("model_presets")
}

/// 上游可用的 wire 格式闭集。合法的 (platform, format) 组合由探针实测决定，不在此硬编码矩阵。
enum ModelUpstreamFormat {
  /// OpenAI Chat Completions；覆盖 OpenAI 与一切 OpenAI 兼容网关（DeepSeek / Kimi / 豆包 / 中转站）
  OPENAI_CHAT_COMPLETIONS
  /// OpenAI Responses；额外支持 reasoning_effort、verbosity 等原生请求参数
  OPENAI_RESPONSES
  /// Anthropic Messages
  ANTHROPIC_MESSAGES
}

/// 探针实测出的预设能力档位。
enum ModelPresetCapability {
  /// 尚未探测过；不允许投入 agent 链路
  UNVERIFIED
  /// 连通性探针失败
  UNREACHABLE
  /// 仅连通性通过；只能用于无工具场景（如 synthesize 节点）
  BASIC
  /// 工具往返闭环通过；可用于带 toolGroups 的 agent 节点
  TOOLS
}

model Conversation {
  id              String                      @id @default(cuid())
  title           String                      @default("新对话")
  userId          String                      @map("user_id")
  /// admin 测试会话标记：端侧会话列表过滤掉，仅 admin 测试工作台可见（与 StreamTask.isTest 对称）
  isTest          Boolean                     @default(false) @map("is_test")
  /// 会话形态：SINGLE 单聊（绑定一个智能体）/ GROUP 群聊（多成员 @ 协作）
  type            ConversationType            @default(SINGLE)
  /// 群聊成员（GROUP）：可被 @ 的智能体列表；单聊（SINGLE）：唯一绑定的智能体
  agentIds        String[]                    @default([]) @map("agent_ids")
  /// 默认回答者：SINGLE=绑定 agent；GROUP=不 @ 时的兜底（null=自动路由）
  defaultAgentId  String?                     @map("default_agent_id")
  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        Message[]
  summary         ConversationSummary?
  sseTasks        SseTask[]
  streamTasks     StreamTask[]
  turnTraceItems  ConversationTurnTraceItem[]
  mcdonaldsOrders McDonaldsOrder[]
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, isTest])
  @@map("conversations")
}

model ConversationSummary {
  id              String       @id @default(cuid())
  conversationId  String       @unique @map("conversation_id")
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  summary         String       @db.Text
  latestMessageId String?      @map("latest_message_id")
  messageCount    Int          @default(0) @map("message_count")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("conversation_summaries")
}

model Message {
  id              String                      @id @default(cuid())
  role            MessageRole
  content         String                      @db.Text
  /// 发言者：assistant 消息记录由哪个智能体生成；null = 默认助手/历史数据
  agentId         String?                     @map("agent_id")
  imageUrl        String?                     @map("image_url")
  status          MessageStatus               @default(DONE)
  conversationId  String                      @map("conversation_id")
  conversation    Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt       DateTime                    @default(now()) @map("created_at")
  sseTasks        SseTask[]
  streamTasks     StreamTask[]
  turnTraceItems  ConversationTurnTraceItem[]
  mcdonaldsOrders McDonaldsOrder[]

  @@index([conversationId])
  @@map("messages")
}

model SseTask {
  id              String        @id @default(cuid())
  type            SseTaskType
  status          SseTaskStatus @default(PENDING)
  userId          String        @map("user_id")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId  String        @map("conversation_id")
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId       String        @map("message_id")
  message         Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  requestPayload  Json          @map("request_payload")
  lastEventId     Int           @default(0) @map("last_event_id")
  fullContent     String        @default("") @map("full_content") @db.Text
  errorMessage    String?       @map("error_message") @db.Text
  startedAt       DateTime?     @map("started_at")
  lastHeartbeatAt DateTime?     @map("last_heartbeat_at")
  completedAt     DateTime?     @map("completed_at")
  expiresAt       DateTime      @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([conversationId])
  @@index([messageId])
  @@map("sse_tasks")
}

model StreamTask {
  id                    String                      @id @default(cuid())
  type                  StreamTaskType
  status                StreamTaskStatus            @default(PENDING)
  userId                String                      @map("user_id")
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId        String?                     @map("conversation_id")
  conversation          Conversation?               @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId             String?                     @map("message_id")
  message               Message?                    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  requestPayload        Json                        @map("request_payload")
  executionState        Json?                       @map("execution_state")
  resultPayload         Json?                       @map("result_payload")
  agentId               String?                     @map("agent_id")
  flowVersionId         String?                     @map("flow_version_id")
  flowDigest            String?                     @map("flow_digest")
  /// Flow 的 flow.run.started 已发出的时刻，兼作「谁先抢到首个节点」的原子判据：
  /// 经 updateMany + `flowRunStartedAt: null` 条件声明，只有 count 为 1 的那个节点发事件。
  /// 不复用 startedAt —— 那一列非 Flow 的 runTask 也写，复用会让 Flow 语义静默失效。
  flowRunStartedAt      DateTime?                   @map("flow_run_started_at")
  /// Flow 运行至今的模型与工具调用累计。放标量列而非 executionState JSON：预算是安全护栏，
  /// 只有 Prisma 原子 increment 才不会被并发节点的整块回写吞掉计数（吞掉即等于无限预算）。
  flowModelCalls        Int                         @default(0) @map("flow_model_calls")
  flowToolCalls         Int                         @default(0) @map("flow_tool_calls")
  temporalWorkflowId    String?                     @map("temporal_workflow_id")
  temporalRunId         String?                     @map("temporal_run_id")
  /// 取消 Signal 的投递终态时间；补偿派发器据此在 SQL 层排除已处理任务，
  /// 避免已投递记录永久占满按 updatedAt 排序的批次而饿死新取消任务
  cancelSignalSettledAt DateTime?                   @map("cancel_signal_settled_at")
  isTest                Boolean                     @default(false) @map("is_test")
  currentAgent          String?                     @map("current_agent")
  currentStep           String?                     @map("current_step")
  currentRunId          String?                     @map("current_run_id")
  lastEventId           Int                         @default(0) @map("last_event_id")
  fullContent           String                      @default("") @map("full_content") @db.Text
  errorMessage          String?                     @map("error_message") @db.Text
  startedAt             DateTime?                   @map("started_at")
  pausedAt              DateTime?                   @map("paused_at")
  lastHeartbeatAt       DateTime?                   @map("last_heartbeat_at")
  completedAt           DateTime?                   @map("completed_at")
  expiresAt             DateTime?                   @map("expires_at")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  runs                  StreamTaskRun[]             @relation("StreamTaskRuns")
  events                StreamTaskEvent[]
  turnTraceItems        ConversationTurnTraceItem[]
  mcdonaldsOrders       McDonaldsOrder[]
  flowVersion           AgentFlowVersion?           @relation("StreamTaskFlowVersion", fields: [flowVersionId], references: [id], onDelete: Restrict)
  agentFlowApprovals    AgentFlowApproval[]         @relation("AgentFlowApprovalTask")
  agentFlowSignalOutbox AgentFlowSignalOutbox[]     @relation("AgentFlowSignalOutboxTask")
  agentFlowNodeRuns     AgentFlowNodeExecution[]    @relation("AgentFlowNodeExecutionTask")
  agentFlowNodeStates   AgentFlowNodeState[]        @relation("AgentFlowNodeStateTask")

  @@index([userId, status])
  @@index([conversationId])
  @@index([messageId])
  @@index([currentRunId])
  @@index([agentId])
  @@index([flowVersionId])
  @@index([temporalWorkflowId])
  @@index([isTest])
  @@map("stream_tasks")
}

model StreamTaskRun {
  id                 String                      @id @default(cuid())
  taskId             String                      @map("task_id")
  task               StreamTask                  @relation("StreamTaskRuns", fields: [taskId], references: [id], onDelete: Cascade)
  sequence           Int
  status             StreamTaskRunStatus         @default(PENDING)
  trigger            String?
  startEventId       Int                         @default(0) @map("start_event_id")
  endEventId         Int?                        @map("end_event_id")
  closeReason        String?                     @map("close_reason")
  startedAt          DateTime?                   @map("started_at")
  endedAt            DateTime?                   @map("ended_at")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  events             StreamTaskEvent[]
  turnTraceItems     ConversationTurnTraceItem[]
  agentFlowApprovals AgentFlowApproval[]         @relation("AgentFlowApprovalRun")

  @@unique([taskId, sequence])
  @@index([taskId, status])
  @@map("stream_task_runs")
}

model StreamTaskEvent {
  id        String         @id @default(cuid())
  taskId    String         @map("task_id")
  streamId  String?        @map("stream_id")
  task      StreamTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stream    StreamTaskRun? @relation(fields: [streamId], references: [id], onDelete: SetNull)
  eventId   Int            @map("event_id")
  eventName String         @map("event_name")
  payload   Json
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([taskId, eventId])
  @@index([taskId, eventId])
  @@index([streamId])
  @@map("stream_task_events")
}

/// 单轮对话执行轨迹项，用于历史消息回显“这轮回复走过哪些决策、节点和工具调用”。
/// 它不是 token 级流式快照；message.delta/tool.call.delta 这类高频事件应只用于实时展示或短期恢复。
model ConversationTurnTraceItem {
  id             String                      @id @default(cuid())
  userId         String                      @map("user_id")
  conversationId String                      @map("conversation_id")
  messageId      String                      @map("message_id")
  taskId         String?                     @map("task_id")
  runId          String?                     @map("run_id")
  parentId       String?                     @map("parent_id")
  traceKey       String?                     @map("trace_key")
  sequence       Int
  depth          Int                         @default(0)
  type           ConversationTraceItemType
  status         ConversationTraceItemStatus @default(RUNNING)
  title          String
  summary        String?                     @db.Text
  detail         String?                     @db.Text
  strategy       String?
  skill          String?
  graph          String?
  nodeKey        String?                     @map("node_key")
  toolName       String?                     @map("tool_name")
  mcpServer      String?                     @map("mcp_server")
  mcpTool        String?                     @map("mcp_tool")
  inputSummary   Json?                       @map("input_summary")
  outputSummary  Json?                       @map("output_summary")
  error          Json?
  metrics        Json?
  metadata       Json?
  startedAt      DateTime?                   @map("started_at")
  endedAt        DateTime?                   @map("ended_at")
  durationMs     Int?                        @map("duration_ms")
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")

  user              User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation      Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message           Message                     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  task              StreamTask?                 @relation(fields: [taskId], references: [id], onDelete: SetNull)
  run               StreamTaskRun?              @relation(fields: [runId], references: [id], onDelete: SetNull)
  parent            ConversationTurnTraceItem?  @relation("TraceItemChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children          ConversationTurnTraceItem[] @relation("TraceItemChildren")
  agentFlowApproval AgentFlowApproval?          @relation("AgentFlowApprovalTrace")

  @@index([taskId, traceKey])
  @@index([conversationId, messageId, sequence])
  @@index([taskId, sequence])
  @@index([runId])
  @@index([parentId])
  @@index([type])
  @@map("conversation_turn_trace_items")
}

/// 一个 Flow 节点执行的终局结果，是节点幂等的唯一事实来源。
/// 唯一键 (taskId, nodeExecutionId) 由数据库强制幂等，而不是靠读写时序：
/// 原先这些结果存在 StreamTask.executionState 这个 JSON blob 里，整块读改写，
/// 两个并发节点会互相覆盖 —— 丢一条完成记录就意味着 Activity 重试会重新调用模型与工具。
model AgentFlowNodeExecution {
  id              String                           @id @default(cuid())
  taskId          String                           @map("task_id")
  /// Workflow 侧按 (workflow, nodeKey) 生成的稳定执行标识
  nodeExecutionId String                           @map("node_execution_id")
  nodeKey         String                           @map("node_key")
  result          AgentFlowNodeExecutionResultKind
  /// result 为 COMPLETED 时 Workflow 要走的下一跳分支键；其余结果为空
  outcome         String?
  summary         String?                          @db.Text
  /// 本节点声明的输出值（FLOW_NODE_OUTPUTS 闭集），供下游节点经 $ref 引用。
  /// 只存契约声明的字段，不存提示词、工具原始出参或审批决定正文。
  outputs         Json?
  /// 失败类别，取值来自 @litter-bear/types/protocol 的 TaskErrorCategory。
  /// 不做成 Prisma enum：那会让同一个闭集有两个源，改一处漏一处不会有任何工具报错。
  /// 读取侧统一经 toTaskErrorCategory 收窄。
  errorCategory   String?                          @map("error_category")
  createdAt       DateTime                         @default(now()) @map("created_at")
  updatedAt       DateTime                         @updatedAt @map("updated_at")

  task StreamTask @relation("AgentFlowNodeExecutionTask", fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, nodeExecutionId])
  @@index([taskId])
  @@map("agent_flow_node_executions")
}

/// 一个 Flow 节点执行**过程中**的内部状态（scratch）。
/// 与 AgentFlowNodeExecution 分表是有意的：那张表「有行即已终结」，是幂等回放的依据；
/// 这张表在节点还没结束时就要写（plan-loop 每步一次 checkpoint、approval 每轮打回一次），
/// 混进同一行会让 create 变成 upsert，毁掉「唯一键冲突 -> 回滚 -> 重试命中缓存」那条收敛路径。
/// 只由节点自己读写，不跨节点共享，因此并发节点之间不存在覆盖。
model AgentFlowNodeState {
  id              String   @id @default(cuid())
  taskId          String   @map("task_id")
  /// Workflow 侧按 (workflow, nodeKey) 生成的稳定执行标识
  nodeExecutionId String   @map("node_execution_id")
  nodeKey         String   @map("node_key")
  /// 节点私有状态：approval 的 revision/feedback、plan-loop 的 stepIndex/observations。
  /// 不存提示词、工具原始出参或审批决定正文。
  state           Json
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  task StreamTask @relation("AgentFlowNodeStateTask", fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, nodeExecutionId])
  @@index([taskId])
  @@map("agent_flow_node_states")
}

/// 一次工具或计划审批的持久化业务事实；id 同时作为对外 approvalId。
model AgentFlowApproval {
  id             String                  @id @default(cuid())
  taskId         String                  @map("task_id")
  runId          String?                 @map("run_id")
  traceItemId    String?                 @unique @map("trace_item_id")
  nodeKey        String                  @map("node_key")
  kind           AgentFlowApprovalKind
  status         AgentFlowApprovalStatus @default(PENDING)
  requestSummary Json                    @map("request_summary")
  decision       Json?
  decidedAt      DateTime?               @map("decided_at")
  decidedById    String?                 @map("decided_by_id")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  task         StreamTask                 @relation("AgentFlowApprovalTask", fields: [taskId], references: [id], onDelete: Cascade)
  run          StreamTaskRun?             @relation("AgentFlowApprovalRun", fields: [runId], references: [id], onDelete: SetNull)
  traceItem    ConversationTurnTraceItem? @relation("AgentFlowApprovalTrace", fields: [traceItemId], references: [id], onDelete: SetNull)
  decidedBy    User?                      @relation("AgentFlowApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  signalOutbox AgentFlowSignalOutbox[]    @relation("AgentFlowApprovalSignalOutbox")

  @@index([taskId, status])
  @@index([runId])
  @@index([decidedById])
  @@map("agent_flow_approvals")
}

/// 审批数据库事务已提交、但尚待送达 Temporal 的 Signal 命令；不复制决定正文。
model AgentFlowSignalOutbox {
  id            String                      @id @default(cuid())
  taskId        String                      @map("task_id")
  approvalId    String                      @unique @map("approval_id")
  status        AgentFlowSignalOutboxStatus @default(PENDING)
  attempts      Int                         @default(0)
  /// 指数退避的下次可派发时间；为空表示立即可派发
  nextAttemptAt DateTime?                   @map("next_attempt_at")
  lastError     String?                     @map("last_error") @db.Text
  deliveredAt   DateTime?                   @map("delivered_at")
  createdById   String?                     @map("created_by_id")
  createdAt     DateTime                    @default(now()) @map("created_at")
  updatedAt     DateTime                    @updatedAt @map("updated_at")

  task      StreamTask        @relation("AgentFlowSignalOutboxTask", fields: [taskId], references: [id], onDelete: Cascade)
  approval  AgentFlowApproval @relation("AgentFlowApprovalSignalOutbox", fields: [approvalId], references: [id], onDelete: Cascade)
  createdBy User?             @relation("AgentFlowSignalOutboxActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt, createdAt])
  @@index([taskId])
  @@index([createdById])
  @@map("agent_flow_signal_outbox")
}

/// 麦当劳 MCP 成功创建的订单业务事实。支付链接独立加密保存，绝不进入 rawSnapshot 或普通 DTO。
model McDonaldsOrder {
  id                     String    @id @default(cuid())
  userId                 String    @map("user_id")
  credentialId           String?   @map("credential_id")
  conversationId         String?   @map("conversation_id")
  messageId              String?   @map("message_id")
  taskId                 String?   @map("task_id")
  externalOrderId        String    @map("external_order_id")
  status                 String?
  statusLabel            String?   @map("status_label")
  storeCode              String?   @map("store_code")
  storeName              String?   @map("store_name")
  orderType              Int?      @map("order_type")
  fulfillmentType        String?   @map("fulfillment_type")
  estimatedFulfillmentAt DateTime? @map("estimated_fulfillment_at")
  totalAmount            Decimal?  @map("total_amount") @db.Decimal(12, 2)
  discountAmount         Decimal?  @map("discount_amount") @db.Decimal(12, 2)
  currency               String?   @default("CNY")
  items                  Json?
  rawSnapshot            Json?     @map("raw_snapshot")
  paymentUrlCiphertext   String?   @map("payment_url_ciphertext") @db.Text
  paymentUrlExpiresAt    DateTime? @map("payment_url_expires_at")
  lastRefreshedAt        DateTime? @map("last_refreshed_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential   McDonaldsCredential?    @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  conversation Conversation?           @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      Message?                @relation(fields: [messageId], references: [id], onDelete: SetNull)
  task         StreamTask?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  refreshes    McDonaldsOrderRefresh[]

  @@unique([userId, credentialId, externalOrderId])
  @@index([userId, createdAt])
  @@index([credentialId])
  @@index([messageId])
  @@map("mcdonalds_orders")
}

/// 用户从订单页主动刷新状态的领域审计；不复用聊天 conversation trace。
model McDonaldsOrderRefresh {
  id           String                      @id @default(cuid())
  orderId      String                      @map("order_id")
  status       McDonaldsOrderRefreshStatus
  statusAfter  String?                     @map("status_after")
  errorMessage String?                     @map("error_message") @db.Text
  safeSnapshot Json?                       @map("safe_snapshot")
  startedAt    DateTime                    @default(now()) @map("started_at")
  completedAt  DateTime?                   @map("completed_at")
  createdAt    DateTime                    @default(now()) @map("created_at")

  order McDonaldsOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("mcdonalds_order_refreshes")
}

