/// 一个 Flow 节点执行的终局形态。
/// 刻意扁平成一个闭集而不是「kind + 可空 stopStatus」两列：
/// 后者能表示出 kind=COMPLETED 同时 stopStatus=ERROR 这种非法组合。
enum AgentFlowNodeExecutionResultKind {
  /// 完成并沿 outcome 分支继续推进
  COMPLETED
  /// 正常结束但不再选择下一条边（例如用户主动终止计划）
  STOPPED_COMPLETED
  STOPPED_CANCELLED
  STOPPED_ERROR
}

