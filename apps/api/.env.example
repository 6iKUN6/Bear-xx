PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
LOG_TO_FILE=false
LOG_FILE_PATH=logs/app.log

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/litter_bear

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Temporal（AgentFlow 本地开发；Docker Compose 内部会覆盖为 temporal:7233）
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-flow-development
TEMPORAL_ORCHESTRATOR_TASK_QUEUE=
TEMPORAL_ACTIVITY_TASK_QUEUE=
TEMPORAL_API_KEY=
TEMPORAL_TLS=false

# Docker 构建的基础镜像；Docker Hub 直连不通时改为团队认可的镜像源前缀，
# 例如 docker.m.daocloud.io/library/node:24-bookworm-slim。
# 必须是 glibc 发行版：@temporalio/core-bridge 不提供 musl 预编译产物。
NODE_IMAGE=node:24-bookworm-slim

# Docker 构建时的 pnpm Registry；网络不稳定时可改为团队认可的镜像地址。
PNPM_REGISTRY=https://registry.npmjs.org/

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# WeChat
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# AI / LLM
# 必填：base64 编码的随机 32 字节密钥，用于加密保存模型预设的 apiKey；例如 `openssl rand -base64 32`。
# 缺失或含非 base64 字符时应用启动即失败——模型配置的唯一来源是库里的密文，没有它一次调用都发不出去。
# 独立于麦当劳凭据与支付链接的密钥，三者爆炸半径分离。
# 生成一次后长期不变：更换会让已存的 api_key_ciphertext 全部无法解密（decrypt 故意抛错不降级），
# 需在后台逐个重填密钥，因此建议同时备份到密码管理器。
LLM_CREDENTIAL_ENCRYPTION_KEY=
#
# ↓↓↓ 以下模型配置键已废弃：模型预设的唯一来源是后台（model_presets 表）。
# 保留它们只为一次性导入：`node apps/api/scripts/import-model-presets-from-env.cjs`
# 导入并在后台测试连接通过后，请从 .env / .env.example / docker-compose 一并删除。
LLM_DEFAULT_MODEL_ID=openai:gpt-4o-mini
LLM_MODEL_PRESETS=[]
LLM_MODEL=
# LLM 调试日志，默认关闭；排查模型流式输出时可临时打开
LLM_DEBUG=false
LLM_DEBUG_CHUNKS=false
LLM_DEBUG_CHUNK_PREVIEW_LENGTH=1000
LLM_DEBUG_TIMEOUT_MS=30000
LLM_DEBUG_PROVIDER=openai

# OpenAI
# OPENAI_API_KEY 既可用于 OpenAI 文本对话，也用于语音转写和图片生成能力
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Kimi
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-0711-preview

# 豆包
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-1-6

# LLM 调用健壮性（可选）
# LLM_MAX_RETRIES：429/5xx/超时的重试次数（指数退避，由 LangChain 消费），默认 3
# LLM_TIMEOUT_MS：单次模型请求超时毫秒，避免请求无限挂起，默认 30000
LLM_MAX_RETRIES=3
LLM_TIMEOUT_MS=30000

# 联网搜索（Tavily，https://tavily.com 注册免费获取，每月 1000 次，免信用卡）
TAVILY_API_KEY=

# OpenAI 原子能力
AI_WHISPER_MODEL=whisper-1
AI_IMAGE_MODEL=dall-e-3


# SSE
SSE_HEARTBEAT_INTERVAL=15000
SSE_BUFFER_TTL=300
STREAM_TASK_BUFFER_TTL=300

# SMS
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ---- 七牛云对象存储 Kodo（图片/音频直传）----
# 密钥：portal.qiniu.com → 密钥管理；密钥只放 env，永不入库
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
# 存储空间名
QINIU_BUCKET=
# 绑定的 CDN 加速域名（含协议），开发期可先填 30 天测试域名
QINIU_BUCKET_DOMAIN=
# 存储区域：z0 华东 / z1 华北 / z2 华南 / na0 北美 / as0 东南亚
QINIU_REGION=z2
# 空间是否私有（私有则访问 URL 走临时签名）
QINIU_BUCKET_PRIVATE=false

# ---- 腾讯云 COS（小程序单对象直传；未配置不影响七牛通道）----
# 密钥：腾讯云控制台 → 访问管理 → API 密钥管理；密钥只放 env，永不入库
COS_SECRET_ID=
COS_SECRET_KEY=
# 存储桶名称，须含 APPID，例如 litter-bear-1250000000
COS_BUCKET=
# 存储桶所属地域，例如 ap-guangzhou
COS_REGION=
# 绑定的 CDN 或 COS 访问域名（含协议）
COS_BUCKET_DOMAIN=

# ---- AI 生图模型（独立于聊天模型；未配置激活 provider 时生图能力返回 503）----
# 激活的生图 provider：seedream（豆包，默认）| openai（gpt-image 系列 / dall-e / 中转站）
IMAGE_GEN_PROVIDER=seedream

# OpenAI 兼容端点（gpt-image 系列 / dall-e / 兼容中转站）——保留，可随时切回
IMAGE_GEN_BASE_URL=
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=gpt-image-2

# 豆包 Seedream（火山方舟 Ark）——文生图/图生图同一 /images/generations 端点
# base_url 用 Ark 地址（末尾 /api/v3，勿再带 /v1）；model 为方舟控制台的接入点/模型 ID
IMAGE_GEN_SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_GEN_SEEDREAM_API_KEY=
IMAGE_GEN_SEEDREAM_MODEL=doubao-seedream-4-5-251128

# McDonalds MCP：用户自行在麦当劳 MCP 平台生成 Token，并在登录后绑定；Token 不写入环境变量。
# 可选：默认 https://mcp.mcd.cn/mcp-servers/mcd-mcp
MCDONALDS_MCP_URL=
# 可选：运行时工具名额外前缀；默认空，工具名形如 mcdonalds__query-meals
MCDONALDS_MCP_TOOL_PREFIX=
# 必填：base64 编码的随机 32 字节密钥，用于加密保存用户绑定的 MCP Token；例如 `openssl rand -base64 32`。
MCDONALDS_CREDENTIAL_ENCRYPTION_KEY=
# 必填：base64 编码的随机 32 字节密钥，用于加密保存官方 payH5Url；建议与凭据密钥使用不同值。
MCDONALDS_PAYMENT_URL_ENCRYPTION_KEY=
