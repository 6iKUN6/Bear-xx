{
  "name": "Litter-Bear-Server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "prisma": {
    "seed": "ts-node --project prisma/tsconfig.seed.json prisma/seed.ts"
  },
  "scripts": {
    "build": "nest build",
    "postinstall": "prisma generate",
    "debug:llm": "node ./scripts/debug-llm.cjs",
    "export:openapi": "node ./scripts/export-openapi.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "start:temporal-worker": "node dist/src/temporal/worker",
    "start:temporal-worker:orchestrator": "TEMPORAL_WORKER_ROLE=orchestrator pnpm run start:temporal-worker",
    "start:temporal-worker:activity": "TEMPORAL_WORKER_ROLE=activity pnpm run start:temporal-worker",
    "start:temporal-worker:dev": "node -r ts-node/register -r tsconfig-paths/register ./src/temporal/worker.ts",
    "start:temporal-worker:orchestrator:dev": "TEMPORAL_WORKER_ROLE=orchestrator pnpm run start:temporal-worker:dev",
    "start:temporal-worker:activity:dev": "TEMPORAL_WORKER_ROLE=activity pnpm run start:temporal-worker:dev",
    "dev:docker:up": "docker compose up --build",
    "dev:docker:down": "docker compose down",
    "dev:docker:reset": "docker compose down --volumes --remove-orphans",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:agent-flow:e2e": "node ./scripts/run-agent-flow-e2e.cjs",
    "test:agent-flow:e2e:runner": "node --test ./scripts/run-agent-flow-e2e.spec.cjs",
    "test:agent-flow:e2e:external": "jest --config ./test/jest-agent-flow-e2e.json --runInBand",
    "test:development-compose": "node --test ./scripts/development-compose.spec.cjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "admin:bootstrap-super": "node ./scripts/bootstrap-super-admin.cjs",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.26",
    "@langchain/core": "^1.2.9",
    "@langchain/google-genai": "^2.3.0",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.4.4",
    "@litter-bear/types": "workspace:*",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.2",
    "@temporalio/client": "1.22.0",
    "@temporalio/worker": "1.22.0",
    "@temporalio/workflow": "1.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "ioredis": "^5.10.0",
    "langchain": "^1.4.4",
    "multer": "^2.1.1",
    "nestjs-pino": "^4.6.0",
    "openai": "^6.27.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@temporalio/testing": "1.22.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "jest-environment-node": "^30.4.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/../../packages/types/src"
    ],
    "testRegex": "src/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.spec.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@litter-bear/types/protocol$": "<rootDir>/../../packages/types/src/protocol/index.ts",
      "^@litter-bear/types/agent-flow$": "<rootDir>/../../packages/types/src/agent-flow/index.ts",
      "^@litter-bear/types$": "<rootDir>/../../packages/types/src/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "watchman": false
  }
}
