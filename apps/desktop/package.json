{
  "name": "@litter-bear/desktop",
  "productName": "Sola",
  "version": "0.1.0",
  "private": true,
  "description": "Sola 桌面端（Electron 壳 + React 19）：对话工作台，消费 C 端 /chat SSE",
  "author": "Sola",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
