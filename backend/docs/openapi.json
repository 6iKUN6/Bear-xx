            }
          }
        },
        "responses": {
          "200": {
            "description": "聊天流式响应",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "发送文本消息并开始流式回复",
        "tags": [
          "聊天"
        ]
      }
    },
