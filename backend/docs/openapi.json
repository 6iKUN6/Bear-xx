    "/api/health": {
      "get": {
        "description": "检查数据库和 Redis 连接状态",
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {},
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "健康检查",
        "tags": [
          "健康检查"
        ]
      }
    }
  },
  "info": {
    "title": "Litter Bear API",
    "description": "Litter Bear 后端接口文档",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "WechatLoginDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "微信登录临时凭证 code",
            "example": "0a1B2c3D4e5F6g"
          }
        },
        "required": [
          "code"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "用户 ID",
            "example": "cmf_user_123"
          },
          "nickname": {
            "type": "string",
            "description": "用户昵称",
            "example": "小熊用户"
          },
          "avatarUrl": {
            "type": "string",
            "description": "用户头像地址",
            "example": ""
          }
        },
        "required": [
          "id",
          "nickname",
          "avatarUrl"
        ]
      },
      "LoginResultDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "访问令牌",
            "example": "eyJhbGciOiJIUzI1NiIs..."
          },
          "refreshToken": {
            "type": "string",
            "description": "刷新令牌",
            "example": "eyJhbGciOiJIUzI1NiIs..."
          },
          "user": {
            "description": "登录用户信息",
            "allOf": [
              {
                "$ref": "#/components/schemas/AuthUserDto"
              }
            ]
          }
        },
        "required": [
          "token",
          "refreshToken",
          "user"
        ]
      },
      "SendCodeDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "手机号码",
            "example": "13812345678"
          }
        },
        "required": [
          "phone"
        ]
      },
      "EmptyResultDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "操作是否成功",
            "example": true
          }
        },
        "required": [
          "success"
        ]
      },
      "AccountLoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "账号名，支持字母、数字和下划线，4 到 20 位",
            "example": "sparkle_01"
          },
          "password": {
            "type": "string",
            "description": "登录密码，至少8位",
            "example": "12345678"
          },
          "nickname": {
            "type": "string",
            "description": "首次自动注册时使用的昵称，不传则默认使用账号名",
            "example": "Sparkle"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "PhoneLoginDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "手机号码",
            "example": "13812345678"
          },
          "code": {
            "type": "string",
            "description": "6位短信验证码",
            "example": "123456"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "刷新令牌",
            "example": "eyJhbGciOiJIUzI1NiIs..."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "用户 ID",
            "example": "cmf_user_123"
          },
          "nickname": {
            "type": "string",
            "description": "用户昵称",
            "example": "小熊用户"
          },
          "avatarUrl": {
            "type": "string",
            "description": "用户头像地址",
            "example": ""
          }
        },
        "required": [
          "id",
          "nickname",
          "avatarUrl"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
