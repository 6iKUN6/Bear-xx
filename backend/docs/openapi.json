    "/api/sse-tasks/{taskId}": {
      "get": {
        "operationId": "SseTaskController_getTask",
        "parameters": [
          {
            "name": "taskId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE 任务状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SseTaskStatusDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "查询 SSE 任务状态",
