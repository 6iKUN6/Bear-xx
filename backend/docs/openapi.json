    "/api/chat/message": {
      "post": {
        "description": "发送一条文本消息并直接建立首轮 SSE 流；若未传 conversationId，则自动创建新会话",
        "operationId": "sendMessage",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionsDto"
