    "/health": {
      "get": {
        "description": "检查数据库和 Redis 连接状态",
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {},
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "健康检查",
        "tags": [
          "健康检查"
        ]
      }
    }
  },
  "info": {
    "title": "Litter Bear API",
    "description": "Litter Bear 后端接口文档",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "WechatLoginDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "微信登录临时凭证 code",
            "example": "0a1B2c3D4e5F6g"
          }
        },
        "required": [
          "code"
        ]
      },
      "SendCodeDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "手机号码",
            "example": "13812345678"
          }
        },
        "required": [
          "phone"
        ]
      },
      "PhoneLoginDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "手机号码",
            "example": "13812345678"
          },
          "code": {
            "type": "string",
            "description": "6位短信验证码",
            "example": "123456"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "刷新令牌",
            "example": "eyJhbGciOiJIUzI1NiIs..."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "description": "用户昵称",
            "example": "小熊同学"
          },
          "avatarUrl": {
            "type": "string",
            "description": "头像 URL",
            "example": "https://example.com/avatar.png"
          }
        }
      },
      "CreateConversationDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "会话标题",
            "example": "新对话"
          }
        }
      },
      "ChatCompletionsDto": {
        "type": "object",
        "properties": {
          "modelId": {
            "type": "string",
            "description": "模型预设 ID，优先级最高，例如 openai:gpt-4o-mini",
            "example": "openai:gpt-4o-mini"
          },
          "provider": {
            "type": "string",
            "description": "LLM Provider 名称，例如 openai",
            "example": "openai"
          },
          "platform": {
            "type": "string",
            "description": "模型平台或商家名称，例如 openai、deepseek",
            "example": "openai"
          },
          "model": {
            "type": "string",
            "description": "模型名称，例如 gpt-4o-mini",
            "example": "gpt-4o-mini"
          },
          "temperature": {
            "type": "number",
            "description": "采样温度，建议范围 0 到 2",
            "example": 0.7
          },
          "maxOutputTokens": {
            "type": "number",
            "description": "最大输出 Token 数",
            "example": 2048
          },
          "topP": {
            "type": "number",
            "description": "Top P 采样参数，范围 0 到 1",
            "example": 1
          },
          "conversationId": {
            "type": "string",
            "description": "会话 ID",
            "example": "conv_abc123"
          },
          "content": {
            "type": "string",
            "description": "用户消息内容",
            "example": "你好，请帮我写一首诗"
          }
        },
        "required": [
          "conversationId",
          "content"
        ]
      },
      "VoiceCompletionsDto": {
        "type": "object",
        "properties": {
          "modelId": {
            "type": "string",
            "description": "模型预设 ID，优先级最高，例如 openai:gpt-4o-mini",
            "example": "openai:gpt-4o-mini"
          },
          "provider": {
            "type": "string",
            "description": "LLM Provider 名称，例如 openai",
            "example": "openai"
          },
          "platform": {
            "type": "string",
            "description": "模型平台或商家名称，例如 openai、deepseek",
            "example": "openai"
          },
          "model": {
            "type": "string",
            "description": "模型名称，例如 gpt-4o-mini",
            "example": "gpt-4o-mini"
          },
          "temperature": {
            "type": "number",
            "description": "采样温度，建议范围 0 到 2",
            "example": 0.7
          },
          "maxOutputTokens": {
            "type": "number",
            "description": "最大输出 Token 数",
            "example": 2048
          },
          "topP": {
            "type": "number",
            "description": "Top P 采样参数，范围 0 到 1",
            "example": 1
          },
          "conversationId": {
            "type": "string",
            "description": "会话 ID",
            "example": "conv_abc123"
          }
        },
        "required": [
          "conversationId"
        ]
      },
      "ImageGenerationDto": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "description": "会话 ID",
            "example": "conv_abc123"
          },
          "prompt": {
            "type": "string",
            "description": "图片生成提示词",
            "example": "一只可爱的小熊在森林里散步",
            "maxLength": 4000
          }
        },
        "required": [
          "conversationId",
          "prompt"
        ]
      },
      "ResumeSseDto": {
        "type": "object",
        "properties": {
          "lastEventId": {
            "type": "number",
            "description": "客户端已收到的最后一个事件 ID",
            "example": 12
          }
        }
      }
    }
  }
}
