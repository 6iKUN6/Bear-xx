PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/litter_bear

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# WeChat
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# AI / LLM
# LLM 默认模型预设 ID，建议显式配置
LLM_DEFAULT_MODEL_ID=openai:gpt-4o-mini
# 高级模型预设配置，留空时会自动根据下方供应商环境变量生成预设
LLM_MODEL_PRESETS=[]
# 通用默认模型名，仅在未指定 LLM_DEFAULT_MODEL_ID 时作为兜底
LLM_MODEL=

# OpenAI
# OPENAI_API_KEY 既可用于 OpenAI 文本对话，也用于语音转写和图片生成能力
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Kimi
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-0711-preview

# 豆包
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-1-6

# OpenAI 原子能力
AI_WHISPER_MODEL=whisper-1
AI_IMAGE_MODEL=dall-e-3


# SSE
SSE_HEARTBEAT_INTERVAL=15000
SSE_BUFFER_TTL=300

# SMS
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
