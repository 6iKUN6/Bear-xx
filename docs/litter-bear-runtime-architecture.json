  "cards": [
    {
      "dot": "cyan",
      "title": "主路径",
      "items": [
        "POST /api/chat/message 在认证和限流后创建 StreamTask，并直接建立首轮 SSE。",
        "Agent 的模型增量和工具状态事件由 StreamTask 持久化后沿同一任务流回传端侧。",
        "端侧以 taskId 与 lastEventId 恢复中断连接，不重新创建任务。"
      ]
    },
    {
      "dot": "emerald",
      "title": "状态归属",
      "items": [
        "PostgreSQL 是会话、消息、StreamTask、运行批次和语义事件的持久事实源。",
        "Redis 保存 Redis Stream 帧、执行锁与短期审批决定；它不替代业务事实。",
        "单进程运行中的取消与实时发布由 StreamTaskRegistry 协调。"
      ]
    },
    {
      "dot": "amber",
      "title": "受控执行",
      "items": [
        "策略路由在 Direct、ReAct、Plan 与 Hybrid 图之间选择，并在结构化决策失败时降级。",
        "CapabilityRegistry 定义工具闭集，CapabilityResolver 按 Agent 配置与策略装配。",
        "需要确认的调用发送 approval.required，任务进入 WAITING_HUMAN；approve、reject 或 edit 后恢复。"
      ]
    },
    {
      "dot": "rose",
      "title": "边界与依赖",
      "items": [
        "移动设备处于不可信边界，JWT、参数白名单和全局限流在 NestJS 入口执行。",
        "模型与工具服务均处在后端信任边界之外；其错误不能伪装为成功事件。",
        "SSE 事件名和载荷统一来自 @litter-bear/types/protocol，前后端不各自维护字符串。"
      ]
    }
  ]
}
