    "quality_profile": "showcase",
    "views": [
      {
        "id": "dispatch",
        "label": "任务创建与派发",
        "focus": ["client", "api", "postgres", "temporal", "orchestrator"],
        "note": "StreamTask 在事务内冻结 FlowVersion，提交后才由派发器幂等启动 Temporal Workflow。"
      },
      {
        "id": "execution",
        "label": "节点执行与记录",
        "focus": ["orchestrator", "activity", "external", "postgres"],
        "note": "Workflow 只做确定性编排；LLM、工具与数据库访问都属于 Activity 的副作用。"
      },
      {
        "id": "approval",
        "label": "审批等待与恢复",
        "focus": ["client", "api", "postgres", "temporal", "orchestrator"],
        "note": "审批事实先进入 PostgreSQL，再以 Signal 唤醒 Workflow；等待期间没有 API 请求或 Worker 线程被占用。"
      },
      {
        "id": "recovery",
        "label": "Worker 故障恢复",
        "focus": ["temporal", "orchestrator", "activity", "postgres"],
        "note": "Temporal 依据已持久化的 History 重新投递任务；外部副作用通过业务幂等键防重。"
      }
    ]
